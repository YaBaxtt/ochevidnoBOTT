# Production
NODE_ENV=production
PORT=3000
PUBLIC_APP_URL=https://your-project.up.railway.app
BOT_TOKEN=123456:replace-me
DATABASE_URL=postgresql://postgres:password@host:5432/railway
ADMIN_TELEGRAM_IDS=123456789

# Do not enable in production. It only makes the visual prototype usable in a browser.
ALLOW_DEMO=0

# Customer support contact shown by /paysupport and the Mini App.
SUPPORT_URL=https://t.me/your_support_username

# Optional: raises TON Center read-only balance request limits.
TONCENTER_API_KEY=
